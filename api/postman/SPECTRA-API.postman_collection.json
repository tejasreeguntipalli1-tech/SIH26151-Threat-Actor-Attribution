            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"json\",\n  \"includeStage2\": true,\n  \"investigatorNotes\": \"Endorse formal MLAT preservation orders for subnet 185.220.101.0/24.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/{{caseId}}/report/generate",
