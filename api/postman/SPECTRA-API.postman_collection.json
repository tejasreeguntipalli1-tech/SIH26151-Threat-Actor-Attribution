          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cases/{{caseId}}/report",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "{{caseId}}", "report"]
            },
            "description": "Retrieve compiled 16-section structured case report payload."
          }
        },
        {
          "name": "Generate Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
