            "description": "Retrieve multi-signal Stage 1 actor clusters and correlation confidence."
          }
        },
        {
          "name": "Run Correlation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weights\": {\n    \"technical\": 30,\n    \"stylometry\": 20,\n    \"behaviour\": 20,\n    \"infrastructure\": 15,\n    \"temporal\": 15\n  },\n  \"recompute\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/{{caseId}}/correlation/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "{{caseId}}", "correlation", "analyze"]
            },
            "description": "Trigger recomputation of actor correlation across the multi-dimensional dataset."
          }
        }
      ]
    },
    {
      "name": "Relationships",
      "item": [
        {
          "name": "Get Relationships",
          "request": {
