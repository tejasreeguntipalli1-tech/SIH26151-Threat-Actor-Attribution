            "url": {
              "raw": "{{baseUrl}}/cases/{{caseId}}/relationships",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "{{caseId}}", "relationships"]
            },
            "description": "Retrieve network graph edge definitions and pairwise scores."
          }
        },
        {
          "name": "Get Relationship",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/relationships/{{relationshipId}}",
