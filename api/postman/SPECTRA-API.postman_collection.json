            "body": {
              "mode": "raw",
              "raw": "{\n  \"justification\": \"Stage 1 correlation reached 92%, firmly clearing the 80% statutory evidentiary standard.\",\n  \"authorizedBy\": \"Senior Inspector INV-017\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/{{caseId}}/attribution/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "{{caseId}}", "attribution", "initiate"]
            },
            "description": "Authorize transition from Stage 1 digital cluster to Stage 2 real-world entity resolution."
          }
        }
      ]
    },
    {
      "name": "Timeline",
      "item": [
        {
          "name": "Get Timeline",
          "request": {
